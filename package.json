{
  "name": "@rubics-code/agent-kit",
  "version": "0.1.0",
  "description": "Agent machinery: tool groups, an approval gate, secret delivery, Infisical Agent Vault keys, a terminal and web chat, and a container mode.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "pack-check": "node scripts/pack-check.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "langchain": "^1.6.8",
    "zod": "^4.6.7",
    "@langchain/openai": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
