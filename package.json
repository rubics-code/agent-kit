{
  "name": "@rubics-code/agent-kit",
  "version": "0.0.0",
  "description": "Agent machinery: tool groups, an approval gate, secret delivery, Infisical Agent Vault keys, a terminal and web chat, and a container mode.",
  "license": "MIT",
  "author": "Rubics Code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubics-code/agent-kit.git"
  },
  "homepage": "https://github.com/rubics-code/agent-kit#readme",
  "bugs": "https://github.com/rubics-code/agent-kit/issues",
  "keywords": [
    "agent",
    "langchain",
    "langgraph",
    "infisical",
    "agent-vault",
    "tools",
    "approval"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-kit": "bin/agent-kit.js"
  },
  "files": [
    "bin",
    "dist",
    "template",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "pack-check": "node scripts/pack-check.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/openai": "^1.8.5",
    "langchain": "^1.6.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
